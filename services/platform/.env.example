# Copy locally and load with: node --env-file=.env dist/main.js
# Select exactly one NAME or absolute NAME_FILE for each secret; unset optional sources entirely.
# File sources must be private, single-link UTF-8 files owned by the service UID (no automatic discovery).
DATABASE_URL=postgresql://tonswap_platform:change-me@127.0.0.1:5432/tonswap_platform
# DATABASE_URL_FILE=/absolute/private/platform-database-url
HOST=127.0.0.1
PORT=18787
PLATFORM_MODE=all
APP_ORIGIN=https://test.tonswap.org
PLATFORM_URL=https://test.tonswap.org/platform
COOKIE_SAME_SITE=lax
TRUST_LOOPBACK_PROXY=1
ALLOW_INSECURE_LOCAL=0
# Generate once: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_FILE=/absolute/private/platform-encryption-key
NETWORKS=testnet
# API base includes /api/indexer/v1. Use HTTPS or explicit localhost-only development mode.
INDEXER_URL_TESTNET=https://test.tonswap.org/api/indexer/v1
# Exact live manifest; required for current DEX prices.
INDEXER_RELEASE_MANIFEST=
# INDEXER_API_KEY=
# INDEXER_API_KEY_FILE=/absolute/private/platform-indexer-key
TON_RPC_URL_TESTNET=https://testnet.toncenter.com/api/v2/jsonRPC
# TON_RPC_API_KEY=
# TON_RPC_API_KEY_FILE=/absolute/private/platform-rpc-key
# Optional dated historical archives only; current prices always use TONSwap DEX.
COINGECKO_TIER=demo
# COINGECKO_API_KEY=
# COINGECKO_API_KEY_FILE=/absolute/private/platform-coingecko-key
# Generate once: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_PRIVATE_KEY_FILE=/absolute/private/platform-vapid-private-key
VAPID_SUBJECT=
GOVERNANCE_CONTRACT_TESTNET=
ASSET_VALUATION_PATHS_JSON=[]
SESSION_HOURS=168
POLL_SECONDS=30
PRICE_SECONDS=15
WORKER_CONCURRENCY=4
RETENTION_DAYS=90
