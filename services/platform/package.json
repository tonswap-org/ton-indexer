{
  "name": "tonswap-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "worker": "PLATFORM_MODE=worker node dist/main.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:native-options": "node scripts/test-native-postgres.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@ton/core": "^0.62.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.4.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.6.1",
    "ipaddr.js": "^2.2.0",
    "lossless-json": "^4.3.0",
    "pg": "^8.16.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
