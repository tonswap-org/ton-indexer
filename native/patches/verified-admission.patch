+td::Status TonlibClient::do_request(const tonlib_api::smc_runGetMethodVerified& request,
+                                    td::Promise<object_ptr<tonlib_api::smc_verifiedRunResult>>&& promise) {
+  // The caller cannot supply a reference root, gas budget, configuration or c7.
+  // This operation always starts from LastBlock's authenticated chain result.
+  if (query_context_.block_id) {
+    return td::Status::Error(400, "ADMISSION_TRUST: withBlock is forbidden");
+  }
+  if (!request.account_address_ || request.expected_code_hash_.size() != 32 ||
+      (request.method_ != "open_order_preflight" && request.method_ != "close_order_preflight") ||
+      request.stack_.size() != (request.method_ == "open_order_preflight" ? 6u : 5u)) {
+    return td::Status::Error(400, "ADMISSION_INPUT: exact qualified admission request required");
+  }
+  TRY_RESULT(address, get_account_address(request.account_address_->account_address_));
+  if (address.workchain != 0) {
+    return td::Status::Error(400, "ADMISSION_IDENTITY: basechain engine required");
+  }
+  td::Ref<vm::Stack> stack(true);
+  size_t input_bytes = 0;
+  int input_cells = 0;
+  unsigned index = 0;
+  const unsigned payload_index = request.method_ == "open_order_preflight" ? 2 : 1;
+  for (const auto& entry : request.stack_) {
+    if (!entry) {
+      return td::Status::Error(400, "ADMISSION_INPUT: empty stack entry");
+    }
+    const auto expected = index == 0 ? tonlib_api::tvm_stackEntrySlice::ID :
+        (index == payload_index || index == payload_index + 2) ? tonlib_api::tvm_stackEntryCell::ID :
+        tonlib_api::tvm_stackEntryNumber::ID;
+    ++index;
+    if (entry->get_id() != expected) return td::Status::Error(400, "ADMISSION_INPUT: exact scalar stack types required");
+    if (expected == tonlib_api::tvm_stackEntryNumber::ID) {
+      const auto& number = static_cast<const tonlib_api::tvm_stackEntryNumber&>(*entry).number_;
+      if (!number || number->number_.empty() || number->number_.size() > 79)
+        return td::Status::Error(400, "ADMISSION_INPUT: integer encoding exceeds bound");
+    } else {
+      td::Slice bytes;
+      if (expected == tonlib_api::tvm_stackEntrySlice::ID) {
+        const auto& cell = static_cast<const tonlib_api::tvm_stackEntrySlice&>(*entry).slice_;
+        if (!cell) return td::Status::Error(400, "ADMISSION_INPUT: missing slice");
+        bytes = cell->bytes_;
+      } else {
+        const auto& cell = static_cast<const tonlib_api::tvm_stackEntryCell&>(*entry).cell_;
+        if (!cell) return td::Status::Error(400, "ADMISSION_INPUT: missing cell");
+        bytes = cell->bytes_;
+      }
+      if (bytes.empty() || bytes.size() > 192 * 1024 - input_bytes)
+        return td::Status::Error(400, "ADMISSION_INPUT: aggregate cell byte bound exceeded");
+      input_bytes += bytes.size();
+      vm::BagOfCells::Info header;
+      const auto length = header.parse_serialized_header(bytes);
+      if (length <= 0 || static_cast<size_t>(length) != bytes.size() || !header.valid ||
+          header.root_count != 1 || header.cell_count <= 0 || header.cell_count > 8192 - input_cells)
+        return td::Status::Error(400, "ADMISSION_INPUT: cell graph bound exceeded");
+      input_cells += header.cell_count;
+    }
+    TRY_RESULT(value, from_tonlib_api(*entry));
+    stack.write().push(std::move(value));
+  }
+  client_.with_last_block(
+      [this, address, stack = std::move(stack), method = request.method_,
+       code_hash = request.expected_code_hash_, promise = std::move(promise)](td::Result<LastBlockState> result) mutable {
+        TRY_RESULT_PROMISE(promise, accepted, std::move(result));
+        const auto master = accepted.last_block_id;
+        client_.send_query(
+            ton::lite_api::liteServer_getAccountState(
+                ton::create_tl_lite_block_id(master),
+                ton::create_tl_object<ton::lite_api::liteServer_accountId>(address.workchain, address.addr)),
+            [this, master, address, stack = std::move(stack), method = std::move(method),
+             code_hash = std::move(code_hash), promise = std::move(promise)](
+                td::Result<ton::lite_api::object_ptr<ton::lite_api::liteServer_accountState>> result) mutable {
+              TRY_RESULT_PROMISE(promise, account, std::move(result));
+              client_.send_query(
+                  ton::lite_api::liteServer_getConfigAll(
+                      block::ConfigInfo::needLibraries | block::ConfigInfo::needPrevBlocks |
+                          block::ConfigInfo::needCapabilities,
+                      ton::create_tl_lite_block_id(master)),
+                  [master, address, stack = std::move(stack), method = std::move(method),
+                   code_hash = std::move(code_hash), account = std::move(account),
+                   promise = std::move(promise)](
+                      td::Result<ton::lite_api::object_ptr<ton::lite_api::liteServer_configInfo>> result) mutable {
+                    TRY_RESULT_PROMISE(promise, config, std::move(result));
+                    const char* phase = "proof";
+                    auto execute = [&]() -> td::Result<object_ptr<tonlib_api::smc_verifiedRunResult>> {
+                      TRY_RESULT(proof, verify_admission_proof(
+                                            master, address, *account, *config,
+                                            static_cast<ton::UnixTime>(std::time(nullptr)), -3));
+                      phase = "vm";
+                      TRY_RESULT(vm, execute_verified_admission(proof, address, code_hash, method, std::move(stack)));
+                      TRY_STATUS(validate_admission_proof_times(
+                          static_cast<ton::UnixTime>(std::time(nullptr)), proof.master_utime, proof.shard_utime));
+                      phase = "serialization";
+                      TRY_RESULT(output_stack, to_tonlib_api(vm.stack));
+                      TRY_RESULT(context, vm::std_boc_serialize(vm.context));
+                      TRY_RESULT(arguments, vm::std_boc_serialize(vm.arguments));
+                      return tonlib_api::make_object<tonlib_api::smc_verifiedRunResult>(
+                          to_tonlib_api(master), to_tonlib_api(proof.shard), proof.master_utime, proof.shard_utime,
+                          proof.shard_lt, proof.config->get_global_version(), account->state_.as_slice().str(),
+                          account->proof_.as_slice().str(), account->shard_proof_.as_slice().str(),
+                          config->state_proof_.as_slice().str(), config->config_proof_.as_slice().str(),
+                          context.as_slice().str(), arguments.as_slice().str(), vm.code->get_hash().as_slice().str(),
+                          vm.data->get_hash().as_slice().str(), proof.config->get_root_cell()->get_hash().as_slice().str(),
+                          kAdmissionGasMax, vm.gas_used, vm.exit_code, std::move(output_stack),
+                          vm.data_unchanged, vm.actions_empty);
+                    };
+                    auto execution = TRY_VM(execute());
+                    if (execution.is_error()) {
+                      if (td::Slice(phase) == "proof") promise.set_error(execution.move_as_error_prefix("ADMISSION_PROOF: "));
+                      else if (td::Slice(phase) == "serialization") promise.set_error(execution.move_as_error_prefix("ADMISSION_CONTEXT: serialization: "));
+                      else promise.set_error(execution.move_as_error());
+                    }
+                    else promise.set_value(execution.move_as_ok());
+                  });
+            });
+      });
+  return td::Status::OK();
+}
